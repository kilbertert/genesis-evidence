# Evidence API (read-only published-evidence surface).
# Copy to /opt/genesis-evidence/var/portal.env, mode 640, owned by the service
# identity. Generate the key on the host; never commit a real value.
GENESIS_EVIDENCE_DATABASE=/opt/genesis-evidence/var/genesis-evidence.sqlite3
GENESIS_EVIDENCE_OBJECTS=/opt/genesis-evidence/var/objects
GENESIS_EVIDENCE_PORTAL_HOST=127.0.0.1
GENESIS_EVIDENCE_PORTAL_PORT=10005
GENESIS_EVIDENCE_API_KEY=replace-with-a-long-random-service-key
