# Review workbench. Shares the database and object store with the Evidence API.
# Copy to /opt/genesis-evidence/var/review.env, mode 640, owned by the service
# identity.
GENESIS_EVIDENCE_DATABASE=/opt/genesis-evidence/var/genesis-evidence.sqlite3
GENESIS_EVIDENCE_OBJECTS=/opt/genesis-evidence/var/objects
GENESIS_EVIDENCE_REVIEW_HOST=127.0.0.1
GENESIS_EVIDENCE_REVIEW_PORT=10006
GENESIS_EVIDENCE_REVIEW_API_KEY=replace-with-a-long-random-review-key
GENESIS_EVIDENCE_REVIEWER_ID=replace-with-the-authenticated-reviewer
