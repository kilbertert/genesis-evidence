[Unit]
Description=Genesis Evidence Paper Review Workbench
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/claude/Projects/genesis-evidence
EnvironmentFile=-/home/claude/Projects/genesis-health/var/review-api.env
EnvironmentFile=/home/claude/Projects/genesis-evidence/var/review.env
ExecStart=/home/claude/.local/bin/uv run --no-sync genesis-evidence-review
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
