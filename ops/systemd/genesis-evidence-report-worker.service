[Unit]
Description=Genesis Evidence Health Report Extraction Worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/claude/Projects/genesis-evidence
EnvironmentFile=/home/claude/Projects/genesis-evidence/var/portal.env
ExecStart=/home/claude/.local/bin/uv run --no-sync python -m genesis_evidence.reports.extraction_worker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
